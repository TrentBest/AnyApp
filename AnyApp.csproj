<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TheSingularityWorkshop.AnyApp</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.AnyApp</RootNamespace>
    <PackageId>TheSingularityWorkshop.AnyApp</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <RepositoryUrl>https://github.com/TrentBest/AnyApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Desktop AnyApp host proving FSM_COS composition through GUI.WPF.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test project is a separate compilation boundary. Prevent the SDK's
         default recursive Compile glob from pulling test sources into AnyApp. -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.4" />
    <PackageReference Include="TheSingularityWorkshop.GUI.WPF" Version="0.1.0-alpha.5" />
  </ItemGroup>
</Project>