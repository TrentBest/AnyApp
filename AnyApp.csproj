<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TheSingularityWorkshop.AnyApp</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.AnyApp</RootNamespace>
    <PackageId>TheSingularityWorkshop.AnyApp</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <RepositoryUrl>https://github.com/TrentBest/AnyApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Desktop AnyApp host proving FSM_COS composition through GUI.WPF.</Description>
  </PropertyGroup>
  <!-- Prefer checked-out source for the three packages that are not published on NuGet.
       Supports both CI's _dependencies layout and sibling repositories in a local Source workspace. -->
  <PropertyGroup>
    <!-- Treat Experiences as a usable source checkout only when both projects referenced below exist.
         A partial/stale checkout must fall back to the published packages, not create a broken ProjectReference. -->
    <WorkshopExperiencesRoot Condition="'$(WorkshopExperiencesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)_dependencies/Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') and Exists('$(MSBuildThisFileDirectory)_dependencies/Experiences/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj')">$(MSBuildThisFileDirectory)_dependencies/Experiences</WorkshopExperiencesRoot>
    <WorkshopExperiencesRoot Condition="'$(WorkshopExperiencesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../TheSingularityWorkshop.Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') and Exists('$(MSBuildThisFileDirectory)../TheSingularityWorkshop.Experiences/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj')">$(MSBuildThisFileDirectory)../TheSingularityWorkshop.Experiences</WorkshopExperiencesRoot>
    <WorkshopExperiencesRoot Condition="'$(WorkshopExperiencesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') and Exists('$(MSBuildThisFileDirectory)../Experiences/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj')">$(MSBuildThisFileDirectory)../Experiences</WorkshopExperiencesRoot>
    <WorkshopMicroBundleRepositoryRoot Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and Exists('$(MSBuildThisFileDirectory)_dependencies/MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj')">$(MSBuildThisFileDirectory)_dependencies/MicroBundleRepository</WorkshopMicroBundleRepositoryRoot>
    <WorkshopMicroBundleRepositoryRoot Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../TheSingularityWorkshop.MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj')">$(MSBuildThisFileDirectory)../TheSingularityWorkshop.MicroBundleRepository</WorkshopMicroBundleRepositoryRoot>
    <WorkshopMicroBundleRepositoryRoot Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj')">$(MSBuildThisFileDirectory)../MicroBundleRepository</WorkshopMicroBundleRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheSingularityWorkshop.AnyApp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="_dependencies/**/*.cs" />
    <!-- Nested dependency source trees are project inputs, not part of AnyApp's WPF XAML compilation. -->
    <Page Remove="_dependencies/**/*.xaml" />
    <ApplicationDefinition Remove="_dependencies/**/*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Development integration resolves our sibling development checkouts; normal/package builds consume released NuGet packages. -->
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.6" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_UserIO" Version="0.1.0-alpha.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.ProtocolAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GrammarAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GUI.WPF" Version="0.1.0-alpha.6" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleRepository.Rest" Version="0.1.0-alpha.2" Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and '$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.Renderer" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.Experiences.Moniker" Version="0.1.0-alpha.3" Condition="'$(WorkshopExperiencesRoot)' == '' and '$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.Experiences.Moniker.Motion.Wave" Version="0.1.0-alpha.1" Condition="'$(WorkshopExperiencesRoot)' == '' and '$(WorkshopUseRepositorySources)' != 'true'" />

    <ProjectReference Include="_dependencies/FSM_API/FSM_API/FSM_API.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.FSM_COS/src/FSM_COS/FSM_COS.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="_dependencies/FSM_UserIO/TheSingularityWorkshop.FSM_UserIO.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.ProtocolAi/TheSingularityWorkshop.ProtocolAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.GrammarAi/TheSingularityWorkshop.GrammarAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="$(WorkshopMicroBundleRepositoryRoot)/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj" Condition="'$(WorkshopMicroBundleRepositoryRoot)' != ''" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />

    <ProjectReference Include="_dependencies/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj"
                      Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)_dependencies/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj')"
                      AdditionalProperties="WorkshopGuiCoreProject=$(MSBuildThisFileDirectory)_dependencies/TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj" />
    <ProjectReference Include="_dependencies/StoryBuilder/src/StoryBuilder.Persistence/StoryBuilder.Persistence.csproj"
                      Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)_dependencies/StoryBuilder/src/StoryBuilder.Persistence/StoryBuilder.Persistence.csproj')" />
    <ProjectReference Include="$(WorkshopExperiencesRoot)/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj" Condition="'$(WorkshopExperiencesRoot)' != '' and Exists('$(WorkshopExperiencesRoot)/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj')" />
    <ProjectReference Include="$(WorkshopExperiencesRoot)/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj" Condition="'$(WorkshopExperiencesRoot)' != '' and Exists('$(WorkshopExperiencesRoot)/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj')" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.Visualize/TheSingularityWorkshop.Visualize.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)_dependencies/TheSingularityWorkshop.Visualize/TheSingularityWorkshop.Visualize.csproj')" />
    <ProjectReference Include="_dependencies/TheSingularityWorkshop.Visualize/integrations/RendererAdapter/TheSingularityWorkshop.Renderer.VisualizeAdapter.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)_dependencies/TheSingularityWorkshop.Visualize/integrations/RendererAdapter/TheSingularityWorkshop.Renderer.VisualizeAdapter.csproj')" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)_dependencies/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj')">
    <DefineConstants>$(DefineConstants);WORKSHOP_STORYBUILDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Update="experiences/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>