<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AnyApp</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.AnyApp</RootNamespace>
    <PackageId>TheSingularityWorkshop.AnyApp</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <RepositoryUrl>https://github.com/TrentBest/AnyApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Desktop AnyApp host proving FSM_COS composition through GUI.WPF.</Description>
  </PropertyGroup>
  <!-- Directory.Build.props supplies one shared source root for local sibling checkouts and CI _dependencies. -->
  <PropertyGroup>
    <WorkshopExperiencesRoot Condition="'$(WorkshopExperiencesRoot)' == '' and Exists('$(WorkshopSourceRoot)/Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj')">$(WorkshopSourceRoot)/Experiences</WorkshopExperiencesRoot>
    <WorkshopExperiencesRoot Condition="'$(WorkshopExperiencesRoot)' == '' and Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj')">$(WorkshopSourceRoot)/TheSingularityWorkshop.Experiences</WorkshopExperiencesRoot>
    <WorkshopMicroBundleRepositoryRoot Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and Exists('$(WorkshopSourceRoot)/MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj')">$(WorkshopSourceRoot)/MicroBundleRepository</WorkshopMicroBundleRepositoryRoot>
    <WorkshopMicroBundleRepositoryRoot Condition="'$(WorkshopMicroBundleRepositoryRoot)' == '' and Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj')">$(WorkshopSourceRoot)/TheSingularityWorkshop.MicroBundleRepository</WorkshopMicroBundleRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TheSingularityWorkshop.AnyApp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="_dependencies/**/*.cs" />
    <!-- Nested dependency source trees are project inputs, not part of AnyApp's WPF XAML compilation. -->
    <Page Remove="_dependencies/**/*.xaml" />
    <ApplicationDefinition Remove="_dependencies/**/*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ordinary dependencies switch between checked-out source and released packages; Renderer remains a source MicroBundle input in both modes. -->
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.6" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_UserIO" Version="0.1.0-alpha.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.ProtocolAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GrammarAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GUI.WPF" Version="0.1.0-alpha.6" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleRepository.Rest" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.Experiences.Moniker" Version="0.1.0-alpha.3" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.Experiences.Moniker.Motion.Wave" Version="0.1.0-alpha.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />

    <ProjectReference Include="$(WorkshopSourceRoot)/FSM_API/FSM_API/FSM_API.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.FSM_COS/src/FSM_COS/FSM_COS.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/FSM_UserIO/TheSingularityWorkshop.FSM_UserIO.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.ProtocolAi/TheSingularityWorkshop.ProtocolAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.GrammarAi/TheSingularityWorkshop.GrammarAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopMicroBundleRepositoryRoot)/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj" Condition="Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj')" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />

    <ProjectReference Include="$(WorkshopSourceRoot)/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj"
                      Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(WorkshopSourceRoot)/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj')"
                      AdditionalProperties="WorkshopGuiCoreProject=$(WorkshopSourceRoot)/TheSingularityWorkshop.GUI/src/Core/TheSingularityWorkshop.GUI.Core.csproj;WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/StoryBuilder/src/StoryBuilder.Persistence/StoryBuilder.Persistence.csproj"
                      Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(WorkshopSourceRoot)/StoryBuilder/src/StoryBuilder.Persistence/StoryBuilder.Persistence.csproj')" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopExperiencesRoot)/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopExperiencesRoot)/src/Moniker.Motion.Wave/TheSingularityWorkshop.Experiences.Moniker.Motion.Wave.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.Visualize/TheSingularityWorkshop.Visualize.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Visualize/TheSingularityWorkshop.Visualize.csproj')" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="$(WorkshopSourceRoot)/TheSingularityWorkshop.Visualize/integrations/RendererAdapter/TheSingularityWorkshop.Renderer.VisualizeAdapter.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Visualize/integrations/RendererAdapter/TheSingularityWorkshop.Renderer.VisualizeAdapter.csproj')" AdditionalProperties="WorkshopUseRepositorySources=$(WorkshopUseRepositorySources);WorkshopSourceRoot=$(WorkshopSourceRoot)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP_USE_REPOSITORY_SOURCES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(WorkshopSourceRoot)/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj')">
    <DefineConstants>$(DefineConstants);WORKSHOP_STORYBUILDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Update="experiences/**/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateWorkshopRepositorySources" BeforeTargets="Restore;ResolveProjectReferences;PrepareForBuild" Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <Error Condition="'$(WorkshopSourceRoot)' == ''" Text="Repository-source mode requires WorkshopSourceRoot. Set it to the common dependency workspace root (the directory containing FSM_API, TheSingularityWorkshop.FSM_COS, and the other development checkouts)." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/FSM_API/FSM_API/FSM_API.csproj')" Text="Repository-source mode is missing FSM_API at $(WorkshopSourceRoot)/FSM_API/FSM_API/FSM_API.csproj. Check out FSM_API development beside AnyApp or under _dependencies." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.FSM_COS/src/FSM_COS/FSM_COS.csproj')" Text="Repository-source mode is missing TheSingularityWorkshop.FSM_COS under $(WorkshopSourceRoot)." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/FSM_UserIO/TheSingularityWorkshop.FSM_UserIO.csproj')" Text="Repository-source mode is missing FSM_UserIO under $(WorkshopSourceRoot)." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.ProtocolAi/TheSingularityWorkshop.ProtocolAi.csproj')" Text="Repository-source mode is missing TheSingularityWorkshop.ProtocolAi under $(WorkshopSourceRoot)." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.GrammarAi/TheSingularityWorkshop.GrammarAi.csproj')" Text="Repository-source mode is missing TheSingularityWorkshop.GrammarAi under $(WorkshopSourceRoot)." />
    <Error Condition="!Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.GUI/src/WPF/TheSingularityWorkshop.GUI.WPF.csproj')" Text="Repository-source mode is missing TheSingularityWorkshop.GUI under $(WorkshopSourceRoot)." />
    <Error Condition="'$(WorkshopMicroBundleRepositoryRoot)' == ''" Text="Repository-source mode is missing MicroBundleRepository under $(WorkshopSourceRoot)." />
    <Error Condition="'$(WorkshopExperiencesRoot)' == ''" Text="Repository-source mode is missing Experiences under $(WorkshopSourceRoot)." />
  </Target>

  <!-- Renderer is a source/MicroBundle composition input in both dependency modes, never a NuGet package. -->
  <Target Name="ValidateWorkshopRendererMicroBundle" BeforeTargets="Restore;ResolveProjectReferences;PrepareForBuild">
    <Error Condition="!Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj')" Text="AnyApp requires the Renderer MicroBundle source at $(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj. Check out TheSingularityWorkshop.Renderer development in the shared workspace." />
  </Target>
</Project>