<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Set the mode in the test project itself: properties set inside a referenced AnyApp project
       do not flow back up to the restore graph that Visual Studio evaluates for this project. -->
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == '' and (Exists('$(MSBuildThisFileDirectory)../../_dependencies/Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') or Exists('$(MSBuildThisFileDirectory)../../_dependencies/MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj') or Exists('$(MSBuildThisFileDirectory)../../../TheSingularityWorkshop.Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') or Exists('$(MSBuildThisFileDirectory)../../../Experiences/src/Moniker/TheSingularityWorkshop.Experiences.Moniker.csproj') or Exists('$(MSBuildThisFileDirectory)../../../TheSingularityWorkshop.MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj') or Exists('$(MSBuildThisFileDirectory)../../../MicroBundleRepository/src/REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj'))">
    <WorkshopUseRepositorySources>true</WorkshopUseRepositorySources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true' and Exists('$(MSBuildThisFileDirectory)../../_dependencies/StoryBuilder/src/StoryBuilder.MicroBundle/StoryBuilder.MicroBundle.csproj')">
    <DefineConstants>$(DefineConstants);WORKSHOP_STORYBUILDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="../../AnyApp.csproj" />
  </ItemGroup>
</Project>